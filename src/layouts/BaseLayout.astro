---
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import ShareMenu from "../components/ShareMenu";
import MobileMenu from "../components/MobileMenu";
import { site } from "../data/site";

type Props = {
  title: string;
  description?: string;
  image?: string;
  breadcrumbs?: {
    href?: string;
    label: string;
  }[];
};

const { title, description = site.description, image = site.ogImage, breadcrumbs = [] } = Astro.props;
const pageTitle = title === "トップ" ? site.name : `${title} | ${site.name}`;
const baseUrl = import.meta.env.DEV ? Astro.url : Astro.site ?? Astro.url;
const canonicalUrl = new URL(Astro.url.pathname, baseUrl).toString();
const imageUrl = new URL(image, baseUrl).toString();
const currentPath = Astro.url.pathname;
const showFooterAboutLink = currentPath !== "/about/";
const nav = [
  { href: "/", label: "ホーム", icon: "home" },
  { href: "/years/", label: "年度", icon: "calendar" },
  { href: "/records/music/", label: "曲", icon: "music" },
  { href: "/records/media/", label: "動画", icon: "video" },
] as const;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="theme-color" content="#fafaf8" />
    <meta name="apple-mobile-web-app-title" content={site.name} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <script type="module" src="/scripts/site.js" is:inline></script>
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">本文へ移動</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href="/">
          <span class="brand-mark" aria-hidden="true"><img src="/favicon.svg" width="24" height="24" alt="" /></span>
          <span>{site.name}<small>広大附属マスゲーム</small></span>
        </a>
        <nav class="site-nav desktop-nav" aria-label="主要ナビゲーション">
          {nav.map((item) => {
            const isCurrent = item.href === "/" ? currentPath === "/" : currentPath.startsWith(item.href);
            return (
              <a href={item.href} aria-current={isCurrent ? "page" : undefined}>
                <Icon name={item.icon} />{item.label}
              </a>
            );
          })}
        </nav>
        <div class="header-actions">
          <a class="header-about" href="/about/">このサイトについて</a>
          <ShareMenu title={pageTitle} text={description} url={canonicalUrl} client:load />
          <div class="mobile-menu"><MobileMenu currentPath={currentPath} client:load /></div>
        </div>
      </div>
    </header>
    <main id="main">
      {breadcrumbs.length > 0 && (
        <nav class="breadcrumbs wrap narrow" aria-label="パンくず">
          <ol>
            <li><a href="/">トップ</a></li>
            {breadcrumbs.map((item, index) => (
              <li>
                {item.href && index < breadcrumbs.length - 1 ? (
                  <a href={item.href}>{item.label}</a>
                ) : (
                  <span aria-current="page">{item.label}</span>
                )}
              </li>
            ))}
          </ol>
        </nav>
      )}
      <slot />
    </main>
    <nav class="bottom-nav" aria-label="スマートフォンのナビゲーション">
      {nav.map((item) => {
        const isCurrent = item.href === "/" ? currentPath === "/" : currentPath.startsWith(item.href);
        return <a href={item.href} aria-current={isCurrent ? "page" : undefined}><Icon name={item.icon} /><span>{item.label}</span></a>;
      })}
    </nav>
    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div><a class="footer-brand" href="/">MassGame Archive<span>あの年の曲と演技を、もう一度。</span></a>
          <p>広大附属マスゲームの非公式アーカイブ。<br />広島大学附属中・高等学校の公式サイトではありません。</p></div>
        <div class="footer-links">
          <a href="/features/by-the-numbers/">数字で見るマスゲーム</a>
          {showFooterAboutLink && <a href="/about/">このサイトについて</a>}
          <a href="/contribute/">連絡・情報提供<Icon name="arrow" /></a>
          <small>曲名・年度・部門・シーン・YouTube動画を掲載しています。</small>
        </div>
      </div>
    </footer>
  </body>
</html>
