---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RecordsTable from "../../components/RecordsTable.astro";
import Icon from "../../components/Icon.astro";
import { entriesForYear, youtubeEmbedUrl, years } from "../../data/archive";

export function getStaticPaths() {
  return years.map((entry) => ({ params: { year: String(entry.year) } }));
}

const yearParam = Number(Astro.params.year);
const record = entriesForYear(yearParam);
if (!record.year) {
  return Astro.redirect("/years/");
}
const sortedYears = [...years].sort((a, b) => a.year - b.year);
const currentIndex = sortedYears.findIndex(({ year }) => year === yearParam);
const previousYear = sortedYears[currentIndex - 1];
const nextYear = sortedYears[currentIndex + 1];
---

<BaseLayout
  title={`${record.year.label}`}
  description={`${record.year.label}の広大附属マスゲームの曲と動画をまとめています。`}
  breadcrumbs={[
    { href: "/years/", label: "年度別" },
    { label: record.year.label },
  ]}
>
  <section class="hero wrap narrow">
    <p class="eyebrow">Year</p>
    <h1>{record.year.label}</h1>
    {record.eventDateLabel && <p class="lead">体育祭: {record.eventDateLabel}</p>}
    <nav class="year-sections" aria-label="この年度の記録"><a href="#music"><Icon name="music" />曲<span class="source-note">{record.music.length}</span></a><a href="#videos"><Icon name="video" />動画<span class="source-note">{record.media.length}</span></a></nav>
  </section>

  <section class="section wrap narrow" id="music">
    <h2>曲</h2>
    {record.missingMusicComment && <p class="data-comment">{record.missingMusicComment}</p>}
    {record.musicSlots.length > 0 ? (
      <RecordsTable entries={record.musicSlots} />
    ) : (
      <p>この年度の曲はまだ確認済みデータがありません。</p>
    )}
  </section>

  <section class="section wrap narrow" id="videos">
    <h2>YouTube</h2>
    {record.media.length > 0 ? (
      <div class="video-grid">
        {record.media.map((entry) => {
          const embedUrl = youtubeEmbedUrl(entry);
          return (
            <article class="video-item">
              <h3>{entry.label}</h3>
              <div class="video-actions">
                <button
                  type="button"
                  class="embed-toggle"
                  data-embed-url={embedUrl}
                  data-embed-title={`${entry.label} YouTube`}
                  disabled={!embedUrl}
                  aria-expanded="false"
                >
                  このページで再生
                </button>
                <a class="youtube-link" href={entry.url}>YouTubeで見る</a>
              </div>
              <div class="embed-slot" aria-live="polite"></div>
            </article>
          );
        })}
      </div>
    ) : (
      <p>この年度のYouTubeリンクは未確認です。</p>
    )}
  </section>
  <nav class="year-page-nav wrap narrow" aria-label="前後の年度">
    {previousYear ? <a href={`/years/${previousYear.year}/`}><span class="previous-arrow"><Icon name="arrow" /></span>{previousYear.year}年度</a> : <span />}
    <a href="/years/">年度一覧</a>
    {nextYear ? <a href={`/years/${nextYear.year}/`}>{nextYear.year}年度<Icon name="arrow" /></a> : <span />}
  </nav>
</BaseLayout>
