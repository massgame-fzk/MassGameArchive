---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RecordsTable from "../../components/RecordsTable.astro";
import { musicSlotEntries } from "../../data/archive";

---

<BaseLayout
  title="曲一覧"
  description="広大附属マスゲームの曲を年度、部門、シーン、曲名・アーティストで探せます。"
  breadcrumbs={[{ label: "曲一覧" }]}
>
  <section class="hero wrap narrow">
    <p class="eyebrow">Music</p>
    <h1>あの曲を、探そう。</h1>
    <p class="lead">年度ごとに、入場から退場までの曲を。<br />曲名・アーティストで検索し、部門・シーンでも絞り込めます。未判明の曲は「調査中」と表示しています。</p>
    <a class="text-link" href="/features/by-the-numbers/">特集：数字で見るマスゲーム <span aria-hidden="true">↗</span></a>
  </section>
  <section class="section wrap narrow">
    <RecordsTable entries={musicSlotEntries} searchable groupedByYear />
  </section>
</BaseLayout>
