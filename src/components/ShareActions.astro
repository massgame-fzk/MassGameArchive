---
import Icon from "./Icon.astro";
import BrandIcon from "./BrandIcon.astro";
import { site } from "../data/site";

type Props = {
  title?: string;
  text?: string;
  url?: string;
};

const baseUrl = import.meta.env.DEV ? Astro.url : Astro.site ?? Astro.url;
const {
  title = site.name,
  text = site.shareText,
  url = new URL(Astro.url.pathname, baseUrl).toString(),
} = Astro.props;

const shareText = `${text} ${url}`;
const xUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(shareText)}`;
const lineUrl = `https://social-plugins.line.me/lineit/share?url=${encodeURIComponent(url)}`;
const facebookUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`;
---

<aside class="share-actions" aria-label="このページを共有" data-share-title={title} data-share-text={text} data-share-url={url}>
  <button class="share-menu-toggle" type="button" aria-expanded="false" aria-label="共有メニューを開く">
    <Icon name="share" />
    <span class="share-menu-close" aria-hidden="true">×</span>
  </button>
  <div class="share-panel">
    <span class="share-heading">共有</span>
    <button class="share-button share-copy" type="button" data-copy-text={shareText}>
      <Icon name="copy" />リンクをコピー
    </button>
    <button class="share-button share-native" type="button">
      <Icon name="share" />共有
    </button>
    <a class="share-button share-link" href={xUrl} target="_blank" rel="noopener noreferrer" data-share-service="x">
      <BrandIcon name="x" />X
    </a>
    <a class="share-button share-link" href={lineUrl} target="_blank" rel="noopener noreferrer" data-share-service="line">
      <BrandIcon name="line" />LINE
    </a>
    <a class="share-button share-link" href={facebookUrl} target="_blank" rel="noopener noreferrer" data-share-service="facebook">
      <BrandIcon name="facebook" />Facebook
    </a>
    <span class="share-status" aria-live="polite"></span>
  </div>
</aside>
