---
import type { MusicEntry, MusicSlotEntry } from "../data/types";

type Props = {
  entries: (MusicEntry | MusicSlotEntry)[];
  searchable?: boolean;
};

const { entries, searchable = false } = Astro.props;
const years = [...new Set(entries.map((entry) => entry.year))].sort((a, b) => b - a);
const groups = [...new Set(entries.map((entry) => entry.group))];
const sceneOrder = ["入場", "一部", "インター", "二部", "三部", "退場"];
const scenes = sceneOrder.filter((scene) => entries.some((entry) => entry.scene === scene));

const columns = [
  { key: "year", label: "年度", type: "number" },
  { key: "group", label: "部門", type: "text" },
  { key: "scene", label: "シーン", type: "text" },
  { key: "title", label: "曲名", type: "text" },
  { key: "artist", label: "アーティスト", type: "text" },
];
---

{searchable && (
  <div class="filters" aria-label="曲一覧の絞り込み">
    <label>
      <span class="source-note">曲名・アーティスト</span>
      <input data-filter="query" type="search" placeholder="例: Gotthard" />
    </label>
    <label>
      <span class="source-note">年度</span>
      <select data-filter="year">
        <option value="">すべて</option>
        {years.map((year) => <option value={year}>{year}</option>)}
      </select>
    </label>
    <label>
      <span class="source-note">部門</span>
      <select data-filter="group">
        <option value="">すべて</option>
        {groups.map((group) => <option value={group}>{group}</option>)}
      </select>
    </label>
    <label>
      <span class="source-note">シーン</span>
      <select data-filter="scene">
        <option value="">すべて</option>
        {scenes.map((scene) => <option value={scene}>{scene}</option>)}
      </select>
    </label>
  </div>
)}

<p class="scroll-hint table-scroll-hint">表は横にスクロールできます</p>
<div class="table-scroll-shell">
  <div class="table-wrap">
    <table data-records-table>
    <thead>
      <tr>
        {columns.map((column) => (
          <th scope="col" aria-sort="none">
            <button
              class="sort-button"
              type="button"
              data-sort-key={column.key}
              data-sort-type={column.type}
            >
              <span>{column.label}</span>
              <span class="sort-indicator" aria-hidden="true"></span>
            </button>
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {entries.map((entry) => (
        <tr
          data-year={entry.year}
          data-group={entry.group}
          data-scene={entry.scene}
          data-title={entry.title}
          data-artist={entry.artist}
          data-status={entry.status}
          data-search={`${entry.title} ${entry.artist} ${entry.status === "unknown" ? "調査中 unknown 未判明" : ""}`.toLowerCase()}
          class:list={[entry.status === "unknown" && "is-unknown"]}
        >
          <td><a href={`/years/${entry.year}/`}>{entry.year}</a></td>
          <td>{entry.group}<span class="source-note"> / {entry.legacyGroup}</span></td>
          <td>{entry.scene}</td>
          <td>{entry.title}</td>
          <td>{entry.artist}</td>
        </tr>
      ))}
    </tbody>
    </table>
  </div>
</div>
